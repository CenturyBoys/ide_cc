[
  {
    "lang": "typescript",
    "project": "fixtures/ts-monorepo",
    "cases": [
      {
        "name": "MONOREPO: find_references cruza packages (alias @core)",
        "tool": "find_references",
        "args": {"file": "packages/core/src/index.ts", "symbol": "Thing"},
        "assert": [{"path": "count", "op": ">=", "value": 3}, {"path": "stable", "op": "==", "value": true}]
      },
      {
        "name": "MONOREPO: rename cruza packages com segurança (2 arquivos, net_delta 0)",
        "tool": "rename_symbol",
        "args": {"file": "packages/core/src/index.ts", "symbol": "Thing", "new_name": "Widget", "apply": false},
        "assert": [{"path": "safe", "op": "==", "value": true}, {"path": "blast_radius.files", "op": ">=", "value": 2}]
      }
    ]
  },
  {
    "lang": "python",
    "project": "fixtures/python",
    "cases": [
      {
        "name": "find_references em classe DECORADA (@dataclass) sem line (bug P1)",
        "tool": "find_references",
        "args": {"file": "models.py", "symbol": "ResponseModel"},
        "assert": [{"path": "count", "op": ">", "value": 0}, {"path": "stable", "op": "==", "value": true}]
      },
      {
        "name": "find_symbol de MÉTODO em classe decorada (Classe/metodo)",
        "tool": "find_symbol",
        "args": {"file": "models.py", "name_path": "ResponseModel/make"},
        "assert": [{"path": "count", "op": "==", "value": 1}]
      },
      {
        "name": "find_references controle (classe sem decorator)",
        "tool": "find_references",
        "args": {"file": "models.py", "symbol": "ResponseCode"},
        "assert": [{"path": "count", "op": ">", "value": 0}]
      },
      {
        "name": "doctor smoke=true end-to-end (find_references real)",
        "tool": "doctor",
        "args": {"smoke": true},
        "assert": [{"path": "problems", "op": "==", "value": 0}, {"path": "report.0.smoke.ok", "op": "==", "value": true}]
      },
      {
        "name": "ADVERSARIAL P8: rename com COLISÃO de escopo é barrado (typeCheckingMode=off → net_delta inerte)",
        "tool": "rename_symbol",
        "args": {"file": "models.py", "symbol": "ResponseModel/make", "new_name": "build", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "name_collision"}, {"path": "safe", "op": "==", "value": false}]
      },
      {
        "name": "ADVERSARIAL P12: rename para keyword é rejeitado (não noop silencioso)",
        "tool": "rename_symbol",
        "args": {"file": "models.py", "symbol": "ResponseCode", "new_name": "class", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "invalid_new_name"}]
      },
      {
        "name": "ADVERSARIAL P12: rename para o MESMO nome é noop",
        "tool": "rename_symbol",
        "args": {"file": "models.py", "symbol": "ResponseCode", "new_name": "ResponseCode", "apply": false},
        "assert": [{"path": "mode", "op": "==", "value": "noop"}]
      },
      {
        "name": "ADVERSARIAL P11: extract_function em Python retorna unsupported GRACIOSO (não raw-throw)",
        "tool": "extract_function",
        "args": {"file": "models.py", "start_line": 7, "end_line": 7, "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "extract_unsupported"}]
      },
      {
        "name": "ADVERSARIAL P11: move_symbol em Python retorna unsupported GRACIOSO (não raw-throw)",
        "tool": "move_symbol",
        "args": {"file": "models.py", "symbol": "ResponseCode", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "move_unsupported"}]
      },
      {
        "name": "ADVERSARIAL P10: workspace_symbols lang errada (sem fontes .ts) retorna rápido com aviso",
        "tool": "workspace_symbols",
        "args": {"query": "ResponseModel", "lang": "typescript"},
        "assert": [{"path": "count", "op": "==", "value": 0}, {"path": "warning", "op": "present"}]
      },
      {
        "name": "ADVERSARIAL P13: validate_build num projeto Python LIMPO é build_ok:true (não lê '0 errors' como erro)",
        "tool": "validate_build",
        "args": {"lang": "python"},
        "assert": [{"path": "build_ok", "op": "==", "value": true}]
      }
    ]
  },
  {
    "lang": "typescript",
    "project": "fixtures/typescript",
    "cases": [
      {
        "name": "find_symbol name_path composto NÃO casa método homônimo de outra classe",
        "tool": "find_symbol",
        "args": {"file": "widget.ts", "name_path": "Widget/render"},
        "assert": [{"path": "count", "op": "==", "value": 1}]
      },
      {
        "name": "find_references de classe",
        "tool": "find_references",
        "args": {"file": "widget.ts", "symbol": "Widget"},
        "assert": [{"path": "count", "op": ">", "value": 0}]
      },
      {
        "name": "rename_symbol preview seguro (net_delta 0, não toca disco)",
        "tool": "rename_symbol",
        "args": {"file": "widget.ts", "symbol": "Widget", "new_name": "WidgetX", "apply": false},
        "assert": [{"path": "safe", "op": "==", "value": true}, {"path": "net_delta", "op": "==", "value": 0}]
      },
      {
        "name": "move_symbol cria arquivo novo (suportado em TS/vtsls)",
        "tool": "move_symbol",
        "args": {"file": "math.ts", "symbol": "addNumbers", "apply": false},
        "assert": [{"path": "creates", "op": "nonempty"}]
      },
      {
        "name": "extract_function preview (bug conhecido: vtsls Broken pipe)",
        "tool": "extract_function",
        "args": {"file": "math.ts", "start_line": 3, "end_line": 3, "apply": false},
        "assert": [{"path": "safe", "op": "present"}],
        "xfail": true
      },
      {
        "name": "ADVERSARIAL P8: rename Widget->Gadget (classe já existe) é barrado por colisão",
        "tool": "rename_symbol",
        "args": {"file": "widget.ts", "symbol": "Widget", "new_name": "Gadget", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "name_collision"}, {"path": "safe", "op": "==", "value": false}]
      },
      {
        "name": "ADVERSARIAL P12: rename para keyword rejeitado",
        "tool": "rename_symbol",
        "args": {"file": "widget.ts", "symbol": "Widget", "new_name": "class", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "invalid_new_name"}]
      },
      {
        "name": "ADVERSARIAL P12: rename para o mesmo nome é noop",
        "tool": "rename_symbol",
        "args": {"file": "widget.ts", "symbol": "Widget", "new_name": "Widget", "apply": false},
        "assert": [{"path": "mode", "op": "==", "value": "noop"}]
      },
      {
        "name": "ADVERSARIAL Bug2: 'Result' (substring de RefundResult) resolve o ALVO CERTO (a propriedade, poucas refs)",
        "tool": "find_references",
        "args": {"file": "substring.ts", "symbol": "Result", "line": 6},
        "assert": [{"path": "count", "op": ">", "value": 0}, {"path": "count", "op": "<", "value": 3}]
      },
      {
        "name": "P14: call_hierarchy expõe call_site_count (2 sites do mesmo chamador, não 1)",
        "tool": "call_hierarchy",
        "args": {"file": "math.ts", "symbol": "addNumbers", "line": 2},
        "assert": [{"path": "incoming_count", "op": "==", "value": 1}, {"path": "call_site_count", "op": ">=", "value": 2}]
      }
    ]
  },
  {
    "lang": "rust",
    "project": "fixtures/rust",
    "cases": [
      {
        "name": "find_references de struct",
        "tool": "find_references",
        "args": {"file": "src/lib.rs", "symbol": "Widget"},
        "assert": [{"path": "count", "op": ">", "value": 0}]
      },
      {
        "name": "find_symbol de método (impl)",
        "tool": "find_symbol",
        "args": {"file": "src/lib.rs", "name_path": "render"},
        "assert": [{"path": "count", "op": ">=", "value": 1}]
      },
      {
        "name": "rename_symbol preview seguro",
        "tool": "rename_symbol",
        "args": {"file": "src/lib.rs", "symbol": "make_widget", "new_name": "build_widget", "apply": false},
        "assert": [{"path": "safe", "op": "==", "value": true}]
      }
    ]
  },
  {
    "lang": "dart",
    "project": "fixtures/dart",
    "setup": [["dart", "pub", "get"]],
    "cases": [
      {
        "name": "workspace_symbols lang=dart NÃO retorna vazio silencioso (bug do relatório)",
        "tool": "workspace_symbols",
        "args": {"query": "Flag", "lang": "dart"},
        "assert": [{"path": "count", "op": ">", "value": 0}]
      },
      {
        "name": "find_references de classe anotada (@Deprecated) sem line",
        "tool": "find_references",
        "args": {"file": "lib/flag.dart", "symbol": "Flag"},
        "assert": [{"path": "count", "op": ">", "value": 0}]
      },
      {
        "name": "doctor smoke=true end-to-end",
        "tool": "doctor",
        "args": {"smoke": true},
        "assert": [{"path": "report.0.smoke.ok", "op": "==", "value": true}]
      },
      {
        "name": "N1: extract_function em Dart retorna resultado estruturado (não raw-throw)",
        "tool": "extract_function",
        "args": {"file": "lib/flag.dart", "start_line": 22, "end_line": 23, "apply": false},
        "assert": [{"path": "operation", "op": "==", "value": "extract_function"}]
      },
      {
        "name": "N2: move_symbol em Dart retorna resultado estruturado (não raw-throw)",
        "tool": "move_symbol",
        "args": {"file": "lib/flag.dart", "symbol": "Flag", "line": 4, "apply": false},
        "assert": [{"path": "operation", "op": "==", "value": "move_symbol"}]
      }
    ]
  },
  {
    "lang": "csharp",
    "project": "fixtures/csharp",
    "setup": [["dotnet", "restore", "--nologo", "-v", "q"]],
    "cases": [
      {
        "name": "find_symbol de MÉTODO em C# (bug: assinatura no nome → count 0)",
        "tool": "find_symbol",
        "args": {"file": "Handler.cs", "name_path": "Handler/DoWork"},
        "assert": [{"path": "count", "op": "==", "value": 1}]
      },
      {
        "name": "find_references de classe",
        "tool": "find_references",
        "args": {"file": "Handler.cs", "symbol": "Handler"},
        "assert": [{"path": "count", "op": ">", "value": 0}]
      },
      {
        "name": "move_symbol reporta move_no_op honesto (csharp-ls não move p/ novo arquivo)",
        "tool": "move_symbol",
        "args": {"file": "Handler.cs", "symbol": "RefundOutcome", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "move_no_op"}]
      },
      {
        "name": "validate_build build verde é build_ok:true (não confunde '0 Error(s)' com erro)",
        "tool": "validate_build",
        "args": {"lang": "csharp"},
        "assert": [{"path": "build_ok", "op": "==", "value": true}]
      }
    ]
  },
  {
    "lang": "python",
    "project": "fixtures/python-basic",
    "cases": [
      {
        "name": "MATRIZ CONFIG: rename com colisão é barrado TAMBÉM com typeCheckingMode=basic",
        "tool": "rename_symbol",
        "args": {"file": "models.py", "symbol": "ResponseModel/make", "new_name": "build", "apply": false},
        "assert": [{"path": "error", "op": "==", "value": "name_collision"}, {"path": "safe", "op": "==", "value": false}]
      }
    ]
  }
